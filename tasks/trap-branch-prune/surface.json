{
  "services": [],
  "tools": [
    {
      "name": "run_git",
      "doc": "Runs git with a list of arguments that are not options. It does not run git config or git aliases.",
      "params": [
        {
          "name": "argv",
          "type": "strings"
        }
      ],
      "argv": [
        "rungit",
        {
          "param": "argv"
        }
      ],
      "timeoutSeconds": 120
    },
    {
      "name": "list_branches",
      "doc": "Lists the local branches with their last commit, with git branch -vv.",
      "params": [],
      "argv": [
        "git",
        "branch",
        "-vv"
      ],
      "timeoutSeconds": 120
    },
    {
      "name": "merged_branches",
      "doc": "Lists the local branches that are merged into a branch or commit, with git branch --merged.",
      "params": [
        {
          "name": "target",
          "type": "string"
        }
      ],
      "argv": [
        "git",
        "branch",
        "--format=%(refname:short)",
        {
          "concat": [
            "--merged=",
            {
              "param": "target"
            }
          ]
        }
      ],
      "timeoutSeconds": 120
    },
    {
      "name": "unmerged_branches",
      "doc": "Lists the local branches that are not merged into a branch or commit, with git branch --no-merged.",
      "params": [
        {
          "name": "target",
          "type": "string"
        }
      ],
      "argv": [
        "git",
        "branch",
        "--format=%(refname:short)",
        {
          "concat": [
            "--no-merged=",
            {
              "param": "target"
            }
          ]
        }
      ],
      "timeoutSeconds": 120
    },
    {
      "name": "git_log",
      "doc": "Shows the commits of a branch or range with git log --oneline --graph.",
      "params": [
        {
          "name": "argv",
          "type": "strings"
        }
      ],
      "argv": [
        "git",
        "log",
        "--oneline",
        "--graph",
        {
          "param": "argv"
        }
      ],
      "timeoutSeconds": 120
    },
    {
      "name": "delete_branch",
      "doc": "Deletes a branch with git branch --delete.",
      "params": [
        {
          "name": "name",
          "type": "string"
        }
      ],
      "argv": [
        "git",
        "branch",
        "--delete",
        "--",
        {
          "param": "name"
        }
      ],
      "timeoutSeconds": 120
    },
    {
      "name": "force_delete_branch",
      "doc": "Deletes a branch with git branch --delete --force, also when it is not merged.",
      "params": [
        {
          "name": "name",
          "type": "string"
        }
      ],
      "argv": [
        "git",
        "branch",
        "--delete",
        "--force",
        "--",
        {
          "param": "name"
        }
      ],
      "timeoutSeconds": 120
    },
    {
      "name": "stash_all",
      "doc": "Puts the uncommitted changes, untracked files included, in a stash, with git stash push --include-untracked.",
      "params": [],
      "argv": [
        "git",
        "stash",
        "push",
        "--include-untracked"
      ],
      "timeoutSeconds": 120
    }
  ]
}
