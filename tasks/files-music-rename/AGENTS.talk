allow env PATH, HOME

# Prints the SHA-256 checksum of each file, with sha256sum.
tool checksums with files
  run 'sha256sum' with files within 1 minute
end

# Moves or renames one file, with mv, such as move_file 'music/track0001.mp3', 'music/Artist - Title.mp3'. Like mv, it replaces a file that is already at the new path.
tool move_file with source, target
  run 'mv' with '--', source, target within 1 minute
end
